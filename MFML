def print_matrix(matrix):
    for row in matrix:
        print(" ".join(f"{x:8.3f}" for x in row))


def back_substitution(aug):
    n = len(aug)
    x = [0.0] * n

    for i in range(n - 1, -1, -1):
        value = aug[i][n]

        for j in range(i + 1, n):
            value -= aug[i][j] * x[j]

        if abs(aug[i][i]) < 1e-12:
            raise ValueError("Zero pivot. No unique solution.")

        x[i] = value / aug[i][i]

    return x


def gaussian_elimination(A, b):
    n = len(A)

    # Check matrix dimensions
    if n == 0 or any(len(row) != n for row in A):
        raise ValueError("Invalid matrix dimensions.")

    if len(b) != n:
        raise ValueError("RHS vector dimension does not match matrix.")

    # Form augmented matrix
    aug = [
        [float(A[i][j]) for j in range(n)] + [float(b[i])]
        for i in range(n)
    ]

    print("\nAugmented Matrix:")
    print_matrix(aug)

    # Forward elimination
    for k in range(n - 1):

        # Partial pivoting
        pivot_row = max(
            range(k, n),
            key=lambda i: abs(aug[i][k])
        )

        if abs(aug[pivot_row][k]) < 1e-12:
            raise ValueError(
                "Singular matrix or system without a unique solution."
            )

        # Swap rows
        if pivot_row != k:
            aug[k], aug[pivot_row] = aug[pivot_row], aug[k]

        # Eliminate elements below pivot
        for i in range(k + 1, n):
            factor = aug[i][k] / aug[k][k]

            for j in range(k, n + 1):
                aug[i][j] -= factor * aug[k][j]

    # Check final pivot
    if abs(aug[n - 1][n - 1]) < 1e-12:
        raise ValueError("Zero pivot. No unique solution.")

    print("\nMatrix after Forward Elimination:")
    print_matrix(aug)

    # Back substitution
    x = back_substitution(aug)

    return x


def verify_solution(A, b, x):
    print("\nVerification:")

    for i in range(len(A)):
        calculated = sum(A[i][j] * x[j] for j in range(len(x)))

        print(
            f"Equation {i + 1}: "
            f"Calculated = {calculated:.3f}, "
            f"Expected = {b[i]:.3f}"
        )


# SYSTEM 1

A1 = [
    [2, 1, -1],
    [-3, -1, 2],
    [-2, 1, 2]
]

b1 = [8, -11, -3]

print("========================================")
print("SYSTEM 1")
print("========================================")

print("\nInput Coefficient Matrix:")
print_matrix(A1)

print("\nRHS Vector:")
print(b1)

try:
    x1 = gaussian_elimination(A1, b1)

    print("\nSolution using Back Substitution:")
    for i in range(len(x1)):
        print(f"x{i + 1} = {x1[i]:.3f}")

    verify_solution(A1, b1, x1)

except ValueError as e:
    print("Error:", e)


